{
  "name": "dev-lucas-lima-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.20.x",
    "npm": "11.19.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts next.config.ts prettier.config.js postcss.config.mjs --ext .js,.mjs,.ts,.tsx --max-warnings=0",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{json,mjs,js,ts}\" \".*.{json,mjs,js}\" \".github/workflows/*.yml\"",
    "typecheck": "tsc --noEmit",
    "structure:check": "node scripts/check-structure.mjs",
    "test": "node --test scripts/*.test.mjs",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run structure:check && npm test && npm run build",
    "lint:fix": "npm run lint -- --fix"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@next/env": "15.5.27",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.12.7",
    "lucide-react": "^0.483.0",
    "next": "15.5.27",
    "next-themes": "^0.4.6",
    "react": "19.0.8",
    "react-dom": "19.0.8",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.5.0",
    "resend": "^4.2.0",
    "sonner": "^2.0.2",
    "tailwind-merge": "^3.0.2",
    "tw-animate-css": "^1.2.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@rocketseat/eslint-config": "^2.2.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.29"
    }
  }
}
